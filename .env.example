# Копирајте во .env.local (не се комитира) и сменете ги вредностите.
# Локална база (од docker-compose.dev.yml):
DATABASE_URL=mysql://classnest:classnest@127.0.0.1:3306/classnest
DB_POOL_SIZE=5

# Клуч за шифрирање на IBAN и датум на раѓање: 64 hex знаци.
# Создавање: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BANK_DATA_KEY=

# Јавна адреса на сајтот (sitemap, robots, Open Graph). Во продукција: https://вашиот-домен
SITE_URL=http://localhost:3000
